@echo off
rem ===========================================================================
rem  sk - safe Claude Code launcher.
rem  Refuses to start Claude anywhere it would misbehave, and always adds the
rem  my-skills repo as a readable directory.
rem  Generated by machine setup. Edit here; nothing regenerates this file.
rem ===========================================================================
setlocal EnableExtensions EnableDelayedExpansion

set "SKILLS_REPO=C:\Users\Kariim\Dev\my-skills"

rem -- switch console to UTF-8 so the dashes below render, remember old page --
set "_OLDCP="
for /f "tokens=2 delims=:" %%c in ('chcp 2^>nul') do set "_OLDCP=%%c"
set "_OLDCP=%_OLDCP: =%"
set "_OLDCP=%_OLDCP:.=%"
chcp 65001 >nul 2>&1

rem -- (a) are we inside a git repo at all? ----------------------------------
git rev-parse --is-inside-work-tree >nul 2>&1
if errorlevel 1 (
  echo NOT IN A REPO — cd into a project first
  goto :bail
)

rem -- (b) are we at the repo root? ------------------------------------------
set "_TOP="
for /f "delims=" %%r in ('git rev-parse --show-toplevel 2^>nul') do set "_TOP=%%r"
set "_TOPW=!_TOP:/=\!"
set "_HERE=%CD%"
if /i not "!_TOPW!"=="!_HERE!" (
  echo WRONG FOLDER — hooks and settings only load from the repo root
  echo cd /d "!_TOPW!"
  goto :bail
)

rem -- (c) are we on a protected branch? -------------------------------------
set "_BR="
for /f "delims=" %%b in ('git rev-parse --abbrev-ref HEAD 2^>nul') do set "_BR=%%b"
if /i "!_BR!"=="main"   goto :protected
if /i "!_BR!"=="master" goto :protected

rem -- (d) all clear: report, then launch ------------------------------------
set "_RM="
for /f "delims=" %%u in ('git remote get-url origin 2^>nul') do set "_RM=%%u"
if not defined _RM set "_RM=(no origin remote)"
for %%i in ("!_TOPW!") do set "_NAME=%%~nxi"

echo repo:   !_NAME!
echo folder: !_TOPW!
echo branch: !_BR!
echo remote: !_RM!

call :restorecp
claude --add-dir "%SKILLS_REPO%" %*
exit /b %ERRORLEVEL%

:protected
echo ON A PROTECTED BRANCH — create a working branch first
echo   git switch -c claude/^<name-your-change^>
goto :bail

:bail
call :restorecp
endlocal
exit /b 1

:restorecp
if defined _OLDCP chcp %_OLDCP% >nul 2>&1
exit /b 0
